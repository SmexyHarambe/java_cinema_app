# Contoh env lokal untuk UAS Disprog Modern.
# Salin menjadi `.env.local` (file itu di-gitignore, TIDAK ke-commit) lalu isi nilai aslinya:
#   cp .env.example .env.local
# `start-ubuntu.sh` otomatis memuat `.env.local` bila ada.

# --- Tujuan TCP server (default localhost = satu mesin dengan backend) ---
# WAJIB diisi IP laptop bila TCP server pindah ke Windows (setup split),
# kalau tidak backend mengirim ke localhost VM yang tidak ada listenernya
# (log: "Failed to send TCP notification", tidak ada paket di Wireshark).
# TCP_SERVER_HOST=192.168.74.1

# --- TLS backend (opsional, default mati = plaintext) ---
# Nyalakan bila TCP server berjalan mode TLS. Truststore = salinan
# tcp-truststore.p12 dari scripts/gen-tls-certs.sh.
# TCP_TLS_ENABLED=true
# TCP_TLS_TRUSTSTORE_PATH=/home/abel/java_cinema_app/tls/tcp-truststore.p12
# TCP_TLS_TRUSTSTORE_PASSWORD=changeit

# --- Override DB bila perlu (default di application.properties biasanya cukup) ---
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/uasdisprog?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=
